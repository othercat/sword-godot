{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pal.native.hud-placement.v1",
  "title": "Optional authored party HUD and battle canvas rectangles",
  "x-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "encounters"],
  "properties": {
    "schema": {"const": "pal.native.hud-placement.v1"},
    "kind": {"const": "content"},
    "encounters": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["encounter_id", "cards_region", "content_region", "max_columns", "slots_by_count", "provenance"],
        "properties": {
          "encounter_id": {"$ref": "#/definitions/id"},
          "cards_region": {"$ref": "#/definitions/rect"},
          "content_region": {"$ref": "#/definitions/rect"},
          "max_columns": {"type": "integer", "minimum": 1, "maximum": 16},
          "slots_by_count": {
            "type": "array", "maxItems": 16,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["count", "slots"],
              "properties": {
                "count": {"type": "integer", "minimum": 1, "maximum": 16},
                "slots": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/definitions/rect"}}
              }
            }
          },
          "provenance": {"$ref": "#/definitions/provenance"}
        }
      }
    }
  },
  "definitions": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"},
    "rect": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 100},
        "y": {"type": "number", "minimum": 0, "maximum": 100},
        "width": {"type": "number", "minimum": 0.01, "maximum": 100},
        "height": {"type": "number", "minimum": 0.01, "maximum": 100}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": {"enum": ["synthetic", "author-choice", "draft-adaptation", "approved"]},
        "source_id": {"$ref": "#/definitions/id"},
        "source_revision": {"type": "string", "maxLength": 128},
        "source_beat_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}}
      }
    }
  }
}
