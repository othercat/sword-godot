{
  "type": "object",
  "required": [
    "schema",
    "kind",
    "encounters"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pal.native.battle-formation.v1"
    },
    "kind": {
      "const": "content"
    },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "encounter_id",
          "party",
          "enemy",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "encounter_id": {
            "$ref": "#/definitions/id"
          },
          "party": {
            "type": "object",
            "required": [
              "region",
              "offset",
              "scale_milli",
              "gap",
              "separate_overlaps",
              "fit",
              "pattern"
            ],
            "additionalProperties": false,
            "properties": {
              "region": {
                "$ref": "#/definitions/region"
              },
              "offset": {
                "$ref": "#/definitions/offset"
              },
              "scale_milli": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4000
              },
              "gap": {
                "type": "number",
                "minimum": 0,
                "maximum": 64
              },
              "separate_overlaps": {
                "type": "boolean"
              },
              "fit": {
                "enum": [
                  "contain",
                  "none"
                ]
              },
              "pattern": {
                "const": "diagonal.v1"
              },
              "slots_by_count": {
                "type": "array",
                "minItems": 0,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": [
                    "count",
                    "slots"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16
                    },
                    "slots": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 16,
                      "items": {
                        "$ref": "#/definitions/point"
                      }
                    }
                  }
                }
              },
              "shadow": {
                "$ref": "#/definitions/shadow"
              }
            }
          },
          "enemy": {
            "type": "object",
            "required": [
              "region",
              "offset",
              "scale_milli",
              "gap",
              "separate_overlaps",
              "fit",
              "pattern"
            ],
            "additionalProperties": false,
            "properties": {
              "region": {
                "$ref": "#/definitions/region"
              },
              "offset": {
                "$ref": "#/definitions/offset"
              },
              "scale_milli": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4000
              },
              "gap": {
                "type": "number",
                "minimum": 0,
                "maximum": 64
              },
              "separate_overlaps": {
                "type": "boolean"
              },
              "fit": {
                "enum": [
                  "contain",
                  "none"
                ]
              },
              "pattern": {
                "const": "diagonal.v1"
              },
              "positions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "required": [
                    "instance_id",
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "instance_id": {
                      "$ref": "#/definitions/id"
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "shadow": {
                      "$ref": "#/definitions/shadow"
                    }
                  }
                }
              },
              "shadow": {
                "$ref": "#/definitions/shadow"
              }
            }
          },
          "provenance": {
            "$ref": "#/definitions/provenance"
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pal.native.battle-formation.v1",
  "title": "pal.native.battle-formation.v1",
  "x-status": "draft",
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "color": {
      "type": "string",
      "minLength": 9,
      "maxLength": 9,
      "pattern": "^#[0-9a-fA-F]{8}$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "synthetic",
            "author-choice",
            "draft-adaptation",
            "approved"
          ]
        },
        "source_id": {
          "$ref": "#/definitions/id"
        },
        "source_revision": {
          "type": "string",
          "maxLength": 128
        },
        "source_beat_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/id"
          }
        }
      }
    },
    "region": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "width": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        },
        "height": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        }
      }
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "shadow": {
          "$ref": "#/definitions/shadow"
        }
      }
    },
    "offset": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -320,
          "maximum": 320
        },
        "y": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        }
      }
    },
    "shadow": {
      "type": "object",
      "required": [
        "enabled",
        "attachment",
        "width",
        "height",
        "offset",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "attachment": {
          "enum": [
            "visible-foot",
            "anchor"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 128
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 64
        },
        "offset": {
          "$ref": "#/definitions/offset"
        },
        "color": {
          "$ref": "#/definitions/color"
        }
      }
    }
  }
}
