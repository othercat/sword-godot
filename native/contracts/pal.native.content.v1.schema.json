{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://othercat.github.io/pal98-runtime-contracts/schemas/pal.native.content.v1.schema.json",
  "title": "pal.native.content.v1",
  "description": "Draft for PAL Wanxiang. Independent of PAL98 Legacy ABI. Unsupported versions and required capabilities must be rejected.",
  "x-status": "draft",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "actor_definitions",
    "entities",
    "maps",
    "scenes",
    "variables",
    "nodes",
    "entry_scene",
    "entry_node",
    "roster",
    "active_party",
    "narrative_cast",
    "assets",
    "extensions",
    "safe_points"
  ],
  "properties": {
    "party_movement_rule": {
      "const": "native.party-trail.v1",
      "description": "Optional continuous follower footsteps with bounded rendezvous planning; requires movement.party-trail.v1. Absence retains the earlier movement behavior."
    },
    "schema": {
      "const": "pal.native.content.v1"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "actor_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "max_hp",
          "max_mp",
          "sprite_asset",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "max_hp": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "max_mp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "sprite_asset": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "type": "object",
            "required": [
              "source_id",
              "status",
              "source_beat_ids"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "synthetic",
                  "author-choice",
                  "draft-adaptation",
                  "approved"
                ]
              },
              "source_beat_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
                },
                "minItems": 0,
                "maxItems": 100,
                "uniqueItems": true
              },
              "source_revision": {
                "type": "string",
                "minLength": 0,
                "maxLength": 128
              }
            },
            "additionalProperties": false
          },
          "map_sprite_set": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional map animation set; omitted/null retains sprite_asset or synthetic silhouette."
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "instance_id",
          "definition_id",
          "scene_id",
          "position",
          "facing",
          "interaction_node",
          "entity_kind"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          },
          "definition_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          },
          "scene_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "additionalProperties": false
          },
          "facing": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "left",
              "right"
            ]
          },
          "interaction_node": {
            "type": [
              "string",
              "null"
            ]
          },
          "entity_kind": {
            "const": "actor"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "maps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "width",
          "height",
          "coordinates",
          "blocked",
          "background_asset"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "coordinates": {
            "type": "object",
            "required": [
              "kind",
              "unit",
              "tile_width",
              "tile_height",
              "origin"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "orthogonal",
                  "isometric"
                ]
              },
              "unit": {
                "const": "tile"
              },
              "tile_width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              },
              "tile_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              },
              "origin": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "blocked": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "y": {
                  "type": "integer",
                  "minimum": -1000000,
                  "maximum": 1000000
                }
              },
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 100000
          },
          "background_asset": {
            "type": [
              "string",
              "null"
            ]
          },
          "movement_rule": {
            "type": "string",
            "enum": [
              "native.grid.v1",
              "pal.walk.v1"
            ],
            "description": "Optional; native.grid.v1 when omitted. pal.walk.v1 requires isometric coordinates and movement.pal-walk.v1 capability. See native-world-movement-v1.md."
          },
          "terrain": {
            "type": "object",
            "required": [
              "tiles",
              "cells",
              "layers"
            ],
            "properties": {
              "tiles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "asset_id",
                    "width",
                    "height",
                    "anchor",
                    "scale_milli"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
                    },
                    "asset_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "anchor": {
                      "type": "object",
                      "required": [
                        "x",
                        "y"
                      ],
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 8192
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 8192
                        }
                      },
                      "additionalProperties": false
                    },
                    "scale_milli": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16000
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 4096
              },
              "cells": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "y": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 65536
              },
              "layers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "draw_order",
                    "depth_sort",
                    "placements"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
                    },
                    "draw_order": {
                      "type": "integer",
                      "minimum": -32,
                      "maximum": 32
                    },
                    "depth_sort": {
                      "type": "boolean"
                    },
                    "placements": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "position",
                          "tile_id",
                          "sort_offset_y"
                        ],
                        "properties": {
                          "position": {
                            "type": "object",
                            "required": [
                              "x",
                              "y"
                            ],
                            "properties": {
                              "x": {
                                "type": "integer",
                                "minimum": -1000000,
                                "maximum": 1000000
                              },
                              "y": {
                                "type": "integer",
                                "minimum": -1000000,
                                "maximum": 1000000
                              }
                            },
                            "additionalProperties": false
                          },
                          "tile_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
                          },
                          "sort_offset_y": {
                            "type": "integer",
                            "minimum": -65536,
                            "maximum": 65536
                          }
                        },
                        "additionalProperties": false
                      },
                      "minItems": 0,
                      "maxItems": 65536
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 16
              }
            },
            "additionalProperties": false,
            "description": "Optional data-only tile layers. cells define available terrain; missing cells reject movement/spawn/save. Requires world.tile-layers.v1. sort_offset_y changes depth ordering, not image placement or logic."
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "map_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "map_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          },
          "entrances": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "display_name",
                "positions",
                "facing",
                "provenance"
              ],
              "properties": {
                "id": {
                  "$ref": "#/definitions/id"
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "positions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/point"
                  },
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true
                },
                "facing": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down",
                    "left",
                    "right"
                  ]
                },
                "provenance": {
                  "$ref": "#/definitions/provenance"
                }
              },
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 128,
            "description": "Optional scene-local entrances. Ordered, distinct, adjacent logical positions reserve party slots; first position is the leader."
          },
          "portals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "display_name",
                "position",
                "transfer_node",
                "reverse_portal",
                "provenance"
              ],
              "properties": {
                "id": {
                  "$ref": "#/definitions/id"
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "position": {
                  "$ref": "#/definitions/point"
                },
                "transfer_node": {
                  "$ref": "#/definitions/id"
                },
                "reverse_portal": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 128
                },
                "provenance": {
                  "$ref": "#/definitions/provenance"
                }
              },
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 128,
            "description": "Optional explicit interaction on the portal cell. Null reverse_portal declares one-way; otherwise validate a reciprocal pair in the transfer destination scene."
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "display_name",
                "event",
                "region",
                "node_id",
                "condition",
                "policy",
                "cooldown_ticks",
                "mutex_group",
                "priority",
                "provenance"
              ],
              "properties": {
                "id": {
                  "$ref": "#/definitions/id"
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "event": {
                  "enum": [
                    "enter",
                    "exit"
                  ]
                },
                "region": {
                  "type": "object",
                  "required": [
                    "origin",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "origin": {
                      "$ref": "#/definitions/point"
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 256
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 256
                    }
                  },
                  "additionalProperties": false
                },
                "node_id": {
                  "$ref": "#/definitions/id"
                },
                "condition": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/definitions/condition"
                    }
                  ]
                },
                "policy": {
                  "enum": [
                    "once",
                    "repeat",
                    "cooldown"
                  ]
                },
                "cooldown_ticks": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 216000
                },
                "mutex_group": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 128
                },
                "priority": {
                  "type": "integer",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "provenance": {
                  "$ref": "#/definitions/provenance"
                }
              },
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 256
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope",
          "type",
          "initial"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          },
          "scope": {
            "type": "string",
            "enum": [
              "profile",
              "run",
              "chapter"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "boolean",
              "integer",
              "string"
            ]
          },
          "initial": {
            "$ref": "#/definitions/value"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "provenance",
              "op",
              "speaker",
              "text",
              "next"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "provenance": {
                "$ref": "#/definitions/provenance"
              },
              "op": {
                "const": "dialogue"
              },
              "speaker": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "next": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "provenance",
              "op",
              "prompt",
              "options"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "provenance": {
                "$ref": "#/definitions/provenance"
              },
              "op": {
                "const": "choice"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text",
                    "next"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "next": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 16
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "provenance",
              "op",
              "variable",
              "value",
              "next"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "provenance": {
                "$ref": "#/definitions/provenance"
              },
              "op": {
                "const": "set"
              },
              "variable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
              },
              "value": {
                "$ref": "#/definitions/value"
              },
              "next": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "provenance",
              "op",
              "variable",
              "equals",
              "then",
              "else"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "provenance": {
                "$ref": "#/definitions/provenance"
              },
              "op": {
                "const": "branch"
              },
              "variable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
              },
              "equals": {
                "$ref": "#/definitions/value"
              },
              "then": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
              },
              "else": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "provenance",
              "op",
