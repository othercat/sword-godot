  "$id": "https://othercat.github.io/pal98-runtime-contracts/schemas/pal.native.content.v1.schema.json",
  "title": "pal.native.content.v1",
  "description": "Draft for PAL Wanxiang. Independent of PAL98 Legacy ABI. Unsupported versions and required capabilities must be rejected.",
  "x-status": "draft",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "actor_definitions",
    "entities",
    "maps",
    "scenes",
    "variables",
    "nodes",
