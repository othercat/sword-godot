{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pal.native.battle-canvas.v1",
  "title": "Authored battle background canvas placement",
  "x-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "encounters"
  ],
  "properties": {
    "schema": {
      "const": "pal.native.battle-canvas.v1"
    },
    "kind": {
      "const": "content"
    },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "encounter_id",
          "region",
          "fit",
          "alignment",
          "matte",
          "provenance"
        ],
        "properties": {
          "encounter_id": {
            "$ref": "#/definitions/id"
          },
          "region": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "width": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 100
              },
              "height": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 100
              }
            }
          },
          "fit": {
            "enum": [
              "cover",
              "contain",
              "stretch"
            ]
          },
          "alignment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "matte": {
            "$ref": "#/definitions/color"
          },
          "provenance": {
            "$ref": "#/definitions/provenance"
          }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "color": {
      "type": "string",
      "minLength": 9,
      "maxLength": 9,
      "pattern": "^#[0-9a-fA-F]{8}$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "synthetic",
            "author-choice",
            "draft-adaptation",
            "approved"
          ]
        },
        "source_id": {
          "$ref": "#/definitions/id"
        },
        "source_revision": {
          "type": "string",
          "maxLength": 128
        },
        "source_beat_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/id"
          }
        }
      }
    }
  }
}
