{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pal.native.battle-layout.v2",
  "title": "Versioned Native battle presentation and explicit enemy feet",
  "x-status": "draft",
  "type": "object",
  "required": ["schema", "kind", "layouts", "encounters", "portraits"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "pal.native.battle-layout.v2"},
    "kind": {"const": "content"},
    "layouts": {
      "type": "array", "minItems": 0, "maxItems": 128,
      "items": {
        "type": "object", "required": ["id", "preset", "sprite_scale_milli", "provenance"], "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "preset": {"enum": ["pal.classic-oblique.v1", "pal.dream-oblique.v1"]},
          "sprite_scale_milli": {"type": "integer", "minimum": 1, "maximum": 4000},
          "provenance": {"$ref": "#/definitions/provenance"}
        }
      }
    },
    "encounters": {
      "type": "array", "minItems": 0, "maxItems": 10000,
      "items": {
        "type": "object", "required": ["encounter_id", "layout_id"], "additionalProperties": false,
        "properties": {
          "encounter_id": {"$ref": "#/definitions/id"}, "layout_id": {"$ref": "#/definitions/id"},
          "enemy_positions": {
            "description": "Optional complete instance mapping for the Dream preset. Final feet in the 320x200 reference canvas; source slots and offsets remain in author provenance, never inferred from compacted indices.",
            "type": "array", "minItems": 1, "maxItems": 5,
            "items": {
              "type": "object", "required": ["instance_id", "x", "y", "provenance"], "additionalProperties": false,
              "properties": {
                "instance_id": {"$ref": "#/definitions/id"},
                "x": {"type": "integer", "minimum": 0, "maximum": 320},
                "y": {"type": "integer", "minimum": 0, "maximum": 200},
                "provenance": {"$ref": "#/definitions/provenance"}
              }
            }
          }
        }
      }
    },
    "portraits": {
      "type": "array", "minItems": 0, "maxItems": 10000,
      "items": {
        "type": "object", "required": ["definition_id", "asset_id", "width", "height", "provenance"], "additionalProperties": false,
        "properties": {
          "definition_id": {"$ref": "#/definitions/id"}, "asset_id": {"$ref": "#/definitions/id"},
          "width": {"type": "integer", "minimum": 1, "maximum": 8192},
          "height": {"type": "integer", "minimum": 1, "maximum": 8192},
          "provenance": {"$ref": "#/definitions/provenance"}
        }
      }
    }
  },
  "definitions": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"},
    "provenance": {
      "type": "object", "required": ["status"], "additionalProperties": false,
      "properties": {
        "status": {"enum": ["synthetic", "author-choice", "draft-adaptation", "approved"]},
        "source_id": {"$ref": "#/definitions/id"},
        "source_revision": {"type": "string", "maxLength": 128},
        "source_beat_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}}
      }
    }
  }
}
