{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/othercat/pal98-runtime-contracts/schemas/pal.native.enemy-actions.v1.schema.json",
  "x-status": "draft",
  "title": "Native ordered enemy actions (optional content component)",
  "type": "object",
  "required": ["schema", "policies"],
  "properties": {
    "schema": {"const": "pal.native.enemy-actions.v1"},
    "policies": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["encounter_id", "instance_id", "rules", "provenance"],
        "properties": {
          "encounter_id": {"$ref": "#/definitions/id"},
          "instance_id": {"$ref": "#/definitions/id"},
          "rules": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": {
              "type": "object",
              "required": ["skill_id", "first_round", "every_rounds", "self_hp_percent", "target"],
              "properties": {
                "skill_id": {"$ref": "#/definitions/id"},
                "first_round": {"type": "integer", "minimum": 1, "maximum": 10000},
                "every_rounds": {"type": "integer", "minimum": 1, "maximum": 10000},
                "self_hp_percent": {"type": "integer", "minimum": 1, "maximum": 100},
                "target": {"enum": ["first", "lowest_hp", "self"]}
              },
              "additionalProperties": false
            }
          },
          "provenance": {
            "type": "object",
            "required": ["status", "source_revision"],
            "properties": {
              "status": {"const": "author-choice"},
              "source_revision": {"type": "string", "maxLength": 128}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "id": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"}
  }
}
