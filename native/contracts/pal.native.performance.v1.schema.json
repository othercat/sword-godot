{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pal.native.performance.v1",
  "title": "Named map performances and resumable presentation state",
  "x-status": "draft",
  "description": "Capability-gated overlays at explicit end-node boundaries. No gameplay effects, actor merging or arbitrary scripts.",
  "oneOf": [
    {
      "$ref": "#/definitions/content"
    },
    {
      "$ref": "#/definitions/state"
    }
  ],
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "synthetic",
            "author-choice",
            "draft-adaptation",
            "approved"
          ]
        },
        "source_id": {
          "$ref": "#/definitions/id"
        },
        "source_revision": {
          "type": "string",
          "maxLength": 128
        },
        "source_beat_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/id"
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "required": [
        "frame_id",
        "asset_id",
        "width",
        "height",
        "duration_us",
        "anchor",
        "scale_milli",
        "layer"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "duration_us": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000000
        },
        "anchor": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8192
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8192
            }
          },
          "additionalProperties": false
        },
        "scale_milli": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16000
        },
        "layer": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "semantic_action",
        "facing",
        "composition",
        "loop",
        "frames",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "semantic_action": {
          "$ref": "#/definitions/id"
        },
        "facing": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "composition": {
          "enum": [
            "single-subject",
            "baked-composite"
          ]
        },
        "loop": {
          "type": "boolean"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/frame"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "clip_id",
        "hide_actor_ids",
        "offset"
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/definitions/id"
        },
        "clip_id": {
          "$ref": "#/definitions/id"
        },
        "hide_actor_ids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/id"
          },
          "minItems": 0,
          "maxItems": 15,
          "uniqueItems": true
        },
        "offset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            }
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "next_node_id",
        "display_name",
        "duration_us",
        "skippable",
        "tracks",
        "provenance"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/definitions/id"
        },
        "next_node_id": {
          "$ref": "#/definitions/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "duration_us": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000000
        },
        "skippable": {
          "type": "boolean"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/track"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "clips",
        "performances"
      ],
      "properties": {
        "schema": {
          "const": "pal.native.performance.v1"
        },
        "kind": {
          "const": "content"
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/clip"
          },
          "minItems": 1,
          "maxItems": 1024
        },
        "performances": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/performance"
          },
          "minItems": 1,
          "maxItems": 1024
        }
      }
    },
    "active": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "elapsed_ticks"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/definitions/id"
        },
        "elapsed_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3599
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "active"
      ],
      "properties": {
        "schema": {
          "const": "pal.native.performance.v1"
        },
        "kind": {
          "const": "state"
        },
        "active": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/active"
            }
          ]
        }
      }
    }
  }
}
