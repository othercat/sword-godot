{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://othercat.github.io/pal98-runtime-contracts/schemas/pal.native.save.v1.schema.json",
  "title": "pal.native.save.v1",
  "description": "Draft for PAL Wanxiang. Independent of PAL98 Legacy ABI. Unsupported versions and required capabilities must be rejected.",
  "x-status": "draft",
  "type": "object",
  "required": [
    "schema",
    "save_id",
    "save_revision",
    "runtime_id",
    "package_id",
    "save_namespace",
    "profile_id",
    "run_id",
    "content_lock",
    "ruleset_hash",
    "commit_id",
    "payload_sha256",
    "state_path",
    "origin",
    "migration",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "pal.native.save.v1"
    },
    "save_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "save_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "save_namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "content_lock": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ruleset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^state/[a-z0-9_.-]+\\.json$"
    },
    "origin": {
      "type": "string",
      "enum": [
        "normal",
        "modified",
        "development_fixture"
      ]
    },
    "migration": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_schema",
          "source_sha256",
          "migrator_id"
        ],
        "properties": {
          "from_schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "migrator_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_id",
        "status",
        "source_beat_ids"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
        },
        "status": {
          "type": "string",
          "enum": [
            "synthetic",
            "author-choice",
            "draft-adaptation",
            "approved"
          ]
        },
        "source_beat_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "source_revision": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object"
    },
    "value": {
      "type": [
        "boolean",
        "integer",
        "string"
      ]
    }
  }
}
