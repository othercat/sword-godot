{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pal.native.story-notice.v1",
  "title": "Optional authored notice at a free-roam story boundary",
  "x-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "notices"],
  "properties": {
    "schema": {"const": "pal.native.story-notice.v1"},
    "kind": {"const": "content"},
    "notices": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {"$ref": "#/definitions/notice"}
    }
  },
  "definitions": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": {"enum": ["synthetic", "author-choice", "draft-adaptation", "approved"]},
        "source_id": {"$ref": "#/definitions/id"},
        "source_revision": {"type": "string", "maxLength": 128},
        "source_beat_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}}
      }
    },
    "notice": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "title", "text", "provenance"],
      "properties": {
        "node_id": {"$ref": "#/definitions/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 128},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "provenance": {"$ref": "#/definitions/provenance"}
      }
    }
  }
}
