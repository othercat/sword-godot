{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://othercat.github.io/pal98-runtime-contracts/schemas/pal.native.package.v1.schema.json",
  "title": "pal.native.package.v1",
  "description": "Draft for PAL Wanxiang. Independent of PAL98 Legacy ABI. Unsupported versions and required capabilities must be rejected.",
  "x-status": "draft",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "version",
    "display_name",
    "content_kind",
    "save_namespace",
    "runtime_api",
    "required_capabilities",
    "optional_capabilities",
    "dependencies",
    "entry_scene",
    "entry_node",
    "execution_class",
    "network_required",
    "content_path",
    "ruleset_id",
    "ruleset_hash",
    "files",
    "contract_hashes",
    "provenance",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "pal.native.package.v1"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "content_kind": {
      "type": "string",
      "enum": [
        "rpg",
        "visual_novel",
        "hybrid"
      ]
    },
    "save_namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "runtime_api": {
      "const": "pal.native.runtime.v1"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "optional_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package_id",
          "version",
          "sha256"
        ],
        "properties": {
          "package_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "entry_scene": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "entry_node": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "execution_class": {
      "const": "data_only"
    },
    "network_required": {
      "const": false
    },
    "content_path": {
      "const": "content/world.json"
    },
    "ruleset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "ruleset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(content|assets|licenses)/[a-zA-Z0-9_-][a-zA-Z0-9_.-]*(?:/[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "kind": {
            "type": "string",
            "enum": [
              "content",
              "texture",
              "audio",
              "font",
              "license"
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10002
    },
    "contract_hashes": {
      "type": "object",
      "required": [
        "pal.native.package.v1",
        "pal.native.content.v1"
      ],
      "properties": {
        "pal.native.package.v1": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pal.native.content.v1": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_id",
        "status",
        "source_beat_ids"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
        },
        "status": {
          "type": "string",
          "enum": [
            "synthetic",
            "author-choice",
            "draft-adaptation",
            "approved"
          ]
        },
        "source_beat_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "source_revision": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_id",
        "status",
        "source_beat_ids"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
        },
        "status": {
          "type": "string",
          "enum": [
            "synthetic",
            "author-choice",
            "draft-adaptation",
            "approved"
          ]
        },
        "source_beat_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "source_revision": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object"
    },
    "value": {
      "type": [
        "boolean",
        "integer",
        "string"
      ]
    }
  }
}
