{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pal.native.sampling.v1",
  "title": "Native presentation sampling profile",
  "x-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "profile", "provenance"],
  "properties": {
    "schema": {"const": "pal.native.sampling.v1"},
    "kind": {"const": "content"},
    "profile": {"enum": ["ClassicLowRes", "PixelHD", "IllustratedHD"]},
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "map_actor": {"$ref": "#/definitions/filter"},
        "map_terrain": {"$ref": "#/definitions/filter"},
        "map_background": {"$ref": "#/definitions/filter"},
        "battle_actor": {"$ref": "#/definitions/filter"},
        "battle_background": {"$ref": "#/definitions/filter"},
        "portrait": {"$ref": "#/definitions/filter"},
        "hud": {"$ref": "#/definitions/filter"},
        "command_ui": {"$ref": "#/definitions/filter"},
        "surface": {"$ref": "#/definitions/filter"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["synthetic", "author-choice", "draft-adaptation", "approved"]},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_revision": {"type": "string", "maxLength": 128}
      }
    }
  },
  "definitions": {
    "filter": {"enum": ["nearest", "linear"]}
  }
}
