{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pal.native.battle-hud.v1",
  "title": "Optional responsive battle HUD boxes and true-color portraits",
  "x-status": "draft",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "layouts",
    "styles",
    "encounters",
    "portraits"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pal.native.battle-hud.v1"
    },
    "kind": {
      "const": "content"
    },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dock",
          "max_columns",
          "card_width",
          "min_card_width",
          "card_height",
          "margin",
          "gap",
          "command_size",
          "reserve_space"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "dock": {
            "enum": [
              "bottom",
              "right"
            ]
          },
          "max_columns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "card_width": {
            "type": "integer",
            "minimum": 144,
            "maximum": 480
          },
          "min_card_width": {
            "type": "integer",
            "minimum": 144,
            "maximum": 480
          },
          "card_height": {
            "type": "integer",
            "minimum": 60,
            "maximum": 160
          },
          "margin": {
            "type": "integer",
            "minimum": 0,
            "maximum": 48
          },
          "gap": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "command_size": {
            "type": "integer",
            "minimum": 32,
            "maximum": 96
          },
          "reserve_space": {
            "type": "boolean"
          }
        }
      }
    },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "encounter_id",
          "layout_id",
          "style_id",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "encounter_id": {
            "$ref": "#/definitions/id"
          },
          "layout_id": {
            "$ref": "#/definitions/id"
          },
          "provenance": {
            "$ref": "#/definitions/provenance"
          },
          "style_id": {
            "$ref": "#/definitions/id"
          }
        }
      }
    },
    "portraits": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "definition_id",
          "asset_id",
          "width",
          "height",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "definition_id": {
            "$ref": "#/definitions/id"
          },
          "asset_id": {
            "$ref": "#/definitions/id"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "provenance": {
            "$ref": "#/definitions/provenance"
          }
        }
      }
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "template",
          "portrait_size",
          "portrait_filter",
          "font_size",
          "colors"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "template": {
            "const": "party-status.hp-mp.v1"
          },
          "portrait_size": {
            "type": "integer",
            "minimum": 24,
            "maximum": 144
          },
          "portrait_filter": {
            "enum": [
              "nearest",
              "linear"
            ]
          },
          "font_size": {
            "type": "integer",
            "minimum": 12,
            "maximum": 24
          },
          "colors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "panel",
              "border",
              "active",
              "text",
              "track",
              "hp",
              "mp"
            ],
            "properties": {
              "panel": {
                "$ref": "#/definitions/color"
              },
              "border": {
                "$ref": "#/definitions/color"
              },
              "active": {
                "$ref": "#/definitions/color"
              },
              "text": {
                "$ref": "#/definitions/color"
              },
              "track": {
                "$ref": "#/definitions/color"
              },
              "hp": {
                "$ref": "#/definitions/color"
              },
              "mp": {
                "$ref": "#/definitions/color"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(?::[a-z0-9][a-z0-9_./-]*)?$"
    },
    "color": {
      "type": "string",
      "minLength": 9,
      "maxLength": 9,
      "pattern": "^#[0-9a-fA-F]{8}$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "synthetic",
            "author-choice",
            "draft-adaptation",
            "approved"
          ]
        },
        "source_id": {
          "$ref": "#/definitions/id"
        },
        "source_revision": {
          "type": "string",
          "maxLength": 128
        },
        "source_beat_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/id"
          }
        }
      }
    }
  }
}
